{
  "type": "origins:active_self",
  "name": "Shadow Step",
  "description": "Land a hit, then step through the dark past your target -- they are left blind and crippled.",
  "entity_action": {
    "type": "origins:and",
    "actions": [
      {
        "type": "origins:spawn_particles",
        "particle": "minecraft:smoke",
        "count": 20,
        "speed": 0.02,
        "force": true,
        "spread": {
          "x": 0.3,
          "y": 0.5,
          "z": 0.3
        }
      },
      {
        "type": "origins:raycast",
        "distance": 6,
        "block": false,
        "entity": true,
        "bientity_action": {
          "type": "origins:target_action",
          "action": {
            "type": "origins:and",
            "actions": [
              {
                "type": "origins:apply_effect",
                "effect": {
                  "effect": "minecraft:blindness",
                  "duration": 40,
                  "amplifier": 0,
                  "is_ambient": true,
                  "show_particles": false,
                  "show_icon": true
                }
              },
              {
                "type": "origins:apply_effect",
                "effect": {
                  "effect": "minecraft:slowness",
                  "duration": 40,
                  "amplifier": 3,
                  "is_ambient": true,
                  "show_particles": false,
                  "show_icon": true
                }
              }
            ]
          }
        },
        "hit_action": {
          "type": "origins:and",
          "actions": [
            {
              "type": "origins:add_velocity",
              "z": 2.2,
              "space": "local_horizontal_normalized",
              "set": true
            },
            {
              "type": "origins:set_fall_distance",
              "fall_distance": 0.0
            },
            {
              "type": "origins:spawn_particles",
              "particle": "minecraft:reverse_portal",
              "count": 25,
              "speed": 0.05,
              "force": true,
              "spread": {
                "x": 0.3,
                "y": 0.5,
                "z": 0.3
              }
            },
            {
              "type": "origins:play_sound",
              "sound": "minecraft:entity.enderman.teleport",
              "volume": 1.0,
              "pitch": 0.8
            }
          ]
        },
        "miss_action": {
          "type": "origins:execute_command",
          "command": "title @s actionbar {\"text\":\"Shadow Step found no target.\",\"color\":\"red\"}"
        }
      }
    ]
  },
  "cooldown": 120,
  "key": {
    "key": "key.origins.primary_active"
  },
  "condition": {
    "type": "origins:and",
    "conditions": [
      {
        "type": "origins:sneaking",
        "inverted": true
      },
      {
        "type": "origins:sprinting",
        "inverted": true
      }
    ]
  },
  "hud_render": {
    "should_render": true,
    "bar_index": 0
  }
}
